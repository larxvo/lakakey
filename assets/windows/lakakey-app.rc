// Lakakey Desktop native Windows resources — icon + version.
// Generated .syso is placed beside Go package sources by the Windows build.
#include <winver.h>

1 ICON "assets/windows/lakakey.ico"

1 VERSIONINFO
FILEVERSION 0,14,1,0
PRODUCTVERSION 0,14,1,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Larx Vo\0"
            VALUE "FileDescription", "Lakakey - Vietnamese input settings\0"
            VALUE "FileVersion", "0.14.1.0\0"
            VALUE "InternalName", "LakakeyDesktop\0"
            VALUE "OriginalFilename", "LakakeyDesktop.exe\0"
            VALUE "ProductName", "Lakakey\0"
            VALUE "ProductVersion", "0.14.1.0\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Larx Vo\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
